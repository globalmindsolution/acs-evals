          "show",
          "--ticket",
          "TKT-1",
          "--skill",
          "code",
          "--iteration",
          "1"
        ]
      },
      "expect": {
        "exit_code": 2,
        "stderr_contains": [
          "verdict ticket_id is 'TKT-9' but this is 'TKT-1'",
          "a verdict is evidence only for the run that produced it"
        ]
      },
      "severity": "critical"
    },
    {
      "id": "VERDICT-009",
      "title": "DIVERGENCE: `verdict show` does not enforce iteration freshness",
      "known_divergence": {
        "observed": "`acs verdict show --iteration 3` reports ok=true, passed=true for a document whose own `iteration` is 1.",
        "expected_by_contract": "validate_verdict checks `iteration` when the caller supplies it, and MAR-527's stated rule is that iteration 1's clean verdict copied onto iteration 3's path is not iteration 3's verdict.",
        "cause": "acs_commands.py cmd_verdict_show calls validate_verdict(doc, lens=..., ticket_id=...) \u2014 it passes neither `skill` nor `iteration`, so those two freshness checks never run at this call site.",
        "blast_radius": "Read-only. The two call sites that decide anything DO pass all three: acs_lib/derive.py (verifier_passed, the field gate_create_pr reads) and acs_lib/lifecycle.py (the SubagentStop hook). So no gate is bypassed \u2014 but the coordinator-facing read command reports a stale verdict as a clean pass.",
        "status": "pinned as observed on the build under test; if v0.4.10 wires the two arguments through, this case fails and should be flipped to expect exit 2."
      },
      "files": [
        {
          "base": "ticket",
          "path": "phases/code/iter-3-verdict.json",
          "fixture": "verdict/stale-iteration.json"
        }
      ],
      "invoke": {
        "argv": [
          "verdict",
          "show",
          "--ticket",
          "TKT-1",
          "--skill",
          "code",
          "--iteration",
          "3"
        ]
      },
      "expect": {
        "exit_code": 0,
        "stdout_json_subset": {
          "ok": true,
          "passed": true,
          "errors": [],
          "verdict": {
            "iteration": 1
          }
        }
      },
      "severity": "critical"
    },
