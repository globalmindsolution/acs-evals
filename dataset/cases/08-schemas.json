        "id": "tkt-1",
        "title": "x",
        "type": "task",
        "description": "",
        "acceptance_criteria": [],
        "priority": "medium",
        "parent": null,
        "children": [],
        "status": "open",
        "external": null,
        "assignee": null,
        "story_points": null,
        "needs_design": false
      },
      "expect": {
        "valid": false,
        "errors_contain": [
          "does not match pattern"
        ]
      }
    },
    {
      "id": "SCHEMA-TICKET-003",
      "kind": "schema",
      "schema": "ticket.schema.json",
