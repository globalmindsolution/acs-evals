        "id": "TKT-1",
        "title": "x",
        "type": "task",
        "description": "",
        "acceptance_criteria": [],
        "priority": "medium",
        "parent": null,
        "children": [],
        "status": "merged",
        "external": null,
        "assignee": null,
        "story_points": null,
        "needs_design": false
      },
      "expect": {
        "valid": false,
        "errors_contain": [
          "is not one of"
        ]
      }
    },
    {
      "id": "SCHEMA-TICKET-004",
      "kind": "schema",
      "schema": "ticket.schema.json",
      "title": "ticket: a missing required field is reported by name",
      "json": {
        "id": "TKT-1",
        "title": "x",
        "type": "task"
      },
      "expect": {
        "valid": false,
        "errors_contain": [
          "$.needs_design: required property is missing"
        ]
      }
    },
