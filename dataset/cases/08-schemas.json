{
  "group": "shipped JSON schemas",
  "description": "Conformance cases for all 12 JSON schemas the acs plugin ships under schemas/. Each schema gets an instance that must be ACCEPTED and at least one that must be REJECTED, with the rejection naming the constraint that did it. These run against the schema files in the build under test, so a schema that loosens a constraint (or tightens one a consumer relies on) fails here rather than in a consumer repo.\n\nValidated by runner/jsonschema_mini.py \u2014 a stdlib subset validator covering exactly the keywords these schemas use. A schema that grows an unsupported keyword raises rather than silently passing.\n\nNote: schemas/acs-messages.xsd is XML, not JSON Schema, and is covered in 09-hooks.json through the plugin's own validate_xml.py.",
  "surface": "schemas/*.json",
  "covers": [
    "MAR-527",
    "MAR-530"
  ],
  "profile": "bare",
  "cases": [
    {
      "id": "SCHEMA-TICKET-001",
      "kind": "schema",
      "schema": "ticket.schema.json",
      "title": "ticket: a fully-populated task is accepted",
      "json": {
        "id": "TKT-1",
        "title": "Add user login",
        "type": "task",
        "description": "",
        "acceptance_criteria": [],
        "priority": "medium",
        "parent": null,
        "children": [],
        "status": "open",
        "external": null,
        "assignee": null,
        "story_points": null,
        "needs_design": false,
        "docs_only": false,
        "size": "small",
        "stakes": "low",
        "lane": "SMALL",
        "created_at": "2026-01-01T00:00:00Z",
        "updated_at": "2026-01-01T00:00:00Z"
      },
      "expect": {
        "valid": true
      }
    },
    {
      "id": "SCHEMA-TICKET-002",
      "kind": "schema",
      "schema": "ticket.schema.json",
      "title": "ticket: a lowercase id is rejected by the id pattern",
